cabal-version: 3.12
name: shibuya-kafka-adapter-bench
version: 0.9.0.2
synopsis: Benchmarks for shibuya-kafka-adapter conversion functions
description:
  Micro-benchmarks for the pure conversion hot path in shibuya-kafka-adapter:
  ConsumerRecord to Envelope conversion, W3C trace header extraction,
  and timestamp conversion.

author: Nadeem Bitar
copyright: 2026 Nadeem Bitar
maintainer: nadeem@gmail.com
homepage: https://github.com/shinzui/shibuya-kafka-adapter
bug-reports: https://github.com/shinzui/shibuya-kafka-adapter/issues
license: MIT
license-file: LICENSE
build-type: Simple
tested-with: ghc ==9.12.2
category: Concurrency, Streaming

source-repository head
  type: git
  location: https://github.com/shinzui/shibuya-kafka-adapter.git

common warnings
  ghc-options:
    -Wall
    -Wcompat
    -Widentities
    -Wincomplete-uni-patterns
    -Wincomplete-record-updates
    -Wredundant-constraints
    -fhide-source-paths
    -Wmissing-export-lists
    -Wpartial-fields
    -Wmissing-deriving-strategies

benchmark shibuya-kafka-adapter-bench
  import: warnings
  type: exitcode-stdio-1.0
  main-is: Main.hs
  hs-source-dirs: bench
  default-language: GHC2024
  ghc-options:
    -Wno-orphans
    -rtsopts
    -with-rtsopts=-A32m
    -fproc-alignment=64

  default-extensions:
    DeriveAnyClass
    DerivingStrategies
    DuplicateRecordFields
    LambdaCase
    NoFieldSelectors
    OverloadedLabels
    OverloadedRecordDot
    OverloadedStrings
    QuasiQuotes
    StandaloneDeriving

  build-depends:
    base ^>=4.21.0.0,
    bytestring ^>=0.12,
    deepseq,
    hw-kafka-client >=5.3 && <6,
    hw-kafka-streamly ^>=0.2,
    shibuya-core ^>=0.10.0.0,
    shibuya-kafka-adapter,
    streamly ^>=0.11,
    streamly-core ^>=0.3,
    tasty-bench,

-- EP-45 live-broker performance and restart fixture.  It owns a uniquely
-- named topic/group, records broker lag and retained heap, and emits the common
-- adapter-soak CSV consumed by shibuya's release analyzer.
executable lifecycle-live
  import: warnings
  main-is: LifecycleLive.hs
  hs-source-dirs: app
  default-language: GHC2024
  ghc-options:
    -threaded
    -rtsopts
    "-with-rtsopts=-N4 -T -A32m"
    -O2

  default-extensions:
    DeriveAnyClass
    DeriveGeneric
    DerivingStrategies
    DuplicateRecordFields
    LambdaCase
    NoFieldSelectors
    OverloadedRecordDot
    OverloadedStrings

  build-depends:
    aeson ^>=2.2,
    async ^>=2.2,
    base ^>=4.21.0.0,
    bytestring ^>=0.12,
    effectful >=2.6 && <2.8,
    effectful-core (>=2.6.1 && <2.7) || (>=2.7.1.1 && <2.8),
    hw-kafka-client >=5.3 && <6,
    kafka-effectful ^>=0.3.1.0,
    process,
    shibuya-core ^>=0.10.0.0,
    shibuya-kafka-adapter,
    stm,
    text ^>=2.1,
    time,
